import requests
from bs4 import BeautifulSoup
import pandas as pd

query = "법인 차량"
news_list = []

for page in range(1, 11):  # 10페이지 크롤링
    url = f"https://search.naver.com/search.naver?where=news&query={query}&start={page*10-9}"
    res = requests.get(url, headers={"User-Agent": "Mozilla/5.0"})
    soup = BeautifulSoup(res.text, "html.parser")
    
    for item in soup.select("ul.list_news div.news_area"):
        title = item.select_one("a.news_tit").text
        link = item.select_one("a.news_tit")["href"]
        news_list.append((title, link))

df = pd.DataFrame(news_list, columns=["제목", "링크"])
print(df.head())







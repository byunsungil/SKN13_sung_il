import requests
from bs4 import BeautifulSoup
import pandas as pd
from collections import Counter
from wordcloud import WordCloud
import matplotlib.pyplot as plt
import re

# ✅ 뉴스 기사 제목 크롤링
query = "법인차 제도"
articles = []

for page in range(1, 6):  # 5페이지 = 약 50개 기사
    start = (page - 1) * 10 + 1
    url = f"https://search.naver.com/search.naver?where=news&query={query}&start={start}"
    headers = {"User-Agent": "Mozilla/5.0"}
    
    res = requests.get(url, headers=headers)
    soup = BeautifulSoup(res.text, "html.parser")
    
    news_items = soup.select("ul.list_news li.bx")
    for item in news_items:
        title_tag = item.select_one("a.news_tit")
        if title_tag:
            articles.append(title_tag["title"])

# ✅ 제목 텍스트 결합 후 정제
text = " ".join(articles)
text = re.sub("[^가-힣\s]", "", text)  # 한글만 남기기

# ✅ 단순 공백 기준 단어 분리
words = text.split()
words = [word for word in words if len(word) > 1]  # 1글자 제거

# ✅ 빈도수 집계
word_freq = Counter(words)

# ✅ 워드클라우드 생성
wc = WordCloud(
    font_path="c:/Windows/Fonts/malgun.ttf",  # 한글 폰트 (윈도우 기준)
    width=800,
    height=400,
    background_color="white"
)
wc.generate_from_frequencies(word_freq)

# ✅ 시각화 출력
plt.figure(figsize=(12, 6))
plt.imshow(wc, interpolation="bilinear")
plt.axis("off")
plt.title(f"네이버 뉴스 워드클라우드: {query}", fontsize=16)
plt.show()


















from selenium import webdriver
from selenium.webdriver.chrome.service import Service
from selenium.webdriver.chrome.options import Options
from selenium.webdriver.common.by import By
import time
from bs4 import BeautifulSoup
import pandas as pd

# 드라이버 경로 설정
driver_path = r"C:\Users\erety\Downloads\chromedriver-win64\chromedriver.exe"

options = Options()
options.add_argument("--start-maximized")
driver = webdriver.Chrome(service=Service(driver_path), options=options)

# 해당 URL로 이동
url = "https://stat.molit.go.kr/portal/cate/statView.do?hFormId=1244&hRsId=58"  # 실제 테이블 주소로 바꿔줘야 함
driver.get(url)
time.sleep(3)

# ✅ 자바스크립트로 내부 테이블 스크롤 조작 (예시: 수직+수평 스크롤)
scroll_script = """
var innerDiv = document.querySelector(".pvtTableContainer > div");  // ← 내부 div 클래스 수정 필요
innerDiv.scrollTop = innerDiv.scrollHeight;
innerDiv.scrollLeft = innerDiv.scrollWidth;
"""
driver.execute_script(scroll_script)
time.sleep(2)

# ✅ 테이블 HTML 추출
table_html = driver.find_element(By.CLASS_NAME, "pvtTable").get_attribute("outerHTML")  # 클래스명은 실제 페이지 기준
driver.quit()

# ✅ BeautifulSoup으로 테이블 파싱
soup = BeautifulSoup(table_html, "html.parser")
table = soup.find("table")
df = pd.read_html(str(table))[0]

# ✅ 결과 확인
print(df.head())



